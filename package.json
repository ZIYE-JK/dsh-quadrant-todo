{
  "name": "dsh-quadrant-todo",
  "version": "1.4.2",
  "description": "Four-quadrant todo manager for the DeepSeek Harness sidebar: month and week calendar views, per-period completion statistics, system and Feishu notifications, and recurrence rules including Chinese statutory workdays and the Ebbinghaus curve.",
  "type": "module",
  "license": "MIT",
  "author": "ZIYE-JK",
  "contributors": [
    "Natte"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "todo",
    "todolist",
    "task",
    "sidebar",
    "eisenhower",
    "quadrant",
    "notification",
    "feishu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIYE-JK/dsh-quadrant-todo.git"
  },
  "homepage": "https://github.com/ZIYE-JK/dsh-quadrant-todo#readme",
  "bugs": {
    "url": "https://github.com/ZIYE-JK/dsh-quadrant-todo/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/**/*.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dshLocalFork": {
    "basedOn": "dsh-sidebar-todo@0.2.3",
    "upstream": "https://github.com/Natte/dsh-sidebar-todo",
    "note": "Derived from Natte/dsh-sidebar-todo 0.2.3 and largely rewritten. Do not install alongside the upstream package: both register the same /todo/api route and share the same todos.json data file."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
