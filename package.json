{
  "name": "dsh-sidebar-todo",
  "version": "0.3.0",
  "description": "DeepSeek Harness 侧栏待办（本地分支改造）：四象限矩阵 + 收集箱 + 子计划 + 月视图日历 + 循环任务 + 分类图标 + 系统通知 / 飞书通知，agent 可读写",
  "type": "module",
  "license": "MIT",
  "author": "Natte",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "todo",
    "todolist",
    "task",
    "sidebar",
    "eisenhower",
    "quadrant",
    "notification",
    "feishu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natte/dsh-sidebar-todo.git"
  },
  "homepage": "https://github.com/Natte/dsh-sidebar-todo#readme",
  "bugs": {
    "url": "https://github.com/Natte/dsh-sidebar-todo/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/**/*.md"
  ],
  "scripts": { "test": "node --test" },
  "publishConfig": { "access": "public" },
  "dshLocalFork": {
    "basedOn": "dsh-sidebar-todo@0.2.3",
    "upstream": "https://github.com/Natte/dsh-sidebar-todo",
    "note": "本地分支改造，未发布；npm 原包保持不动，回退只需改回 profile 依赖。"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-locale"] }
  }
}
